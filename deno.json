{
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check mod.ts && deno test --allow-read=.tmp-lock-test --allow-write=.tmp-lock-test",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --allow-read=.tmp-lock-test --allow-write=.tmp-lock-test"
  },
  "fmt": {
    "exclude": [
      "src/.todo.md",
      "src/.in-progress.md",
      "src/.done.md",
      "backlog/"
    ]
  },
  "minimumDependencyAge": "P7D"
}
